# ═══════════════════════════════════════════════════════════
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - MEGA MODA
# ═══════════════════════════════════════════════════════════
#
# INSTRUCCIONES:
# 1. Copiar este archivo como .env (sin .example)
# 2. Completar los valores reales
# 3. NUNCA commitear .env a Git (está en .gitignore)
#
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────

# Host de la base de datos
DB_HOST=localhost

# Usuario de la base de datos
DB_USER=u467512787_moda

# Contraseña de la base de datos (CAMBIAR POR UNA SEGURA)
DB_PASS=TU_PASSWORD_SEGURO_AQUI

# Nombre de la base de datos
DB_NAME=u467512787_mega

# ─────────────────────────────────────────────────────────
# APLICACIÓN
# ─────────────────────────────────────────────────────────

# Ambiente: development, staging, production
APP_ENV=development

# URL base de la aplicación
APP_URL=http://localhost

# ─────────────────────────────────────────────────────────
# SEGURIDAD
# ─────────────────────────────────────────────────────────

# Secret key para sesiones (generar uno aleatorio único)
# Puedes generar uno con: php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=GENERAR_UN_HASH_ALEATORIO_DE_64_CARACTERES_AQUI

# ─────────────────────────────────────────────────────────
# CONFIGURACIÓN ADICIONAL (OPCIONAL)
# ─────────────────────────────────────────────────────────

# Tiempo de vida de sesión en segundos (default: 3600 = 1 hora)
# SESSION_LIFETIME=3600

# Máximo de intentos de login (default: 5)
# MAX_LOGIN_ATTEMPTS=5

# Tiempo de bloqueo en segundos (default: 900 = 15 minutos)
# LOGIN_LOCKOUT_TIME=900